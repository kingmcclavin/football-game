{
  "name": "gridiron-legacy",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Gridiron Legacy - a browser-based American football career game",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
